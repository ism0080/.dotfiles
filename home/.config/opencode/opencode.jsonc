{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "Qwen3-8B-Q4_K_M": {
          "name": "Qwen3-8B-Q4_K_M Local",
          "limit": {
            "context": 16384,
            "output": 16384,
          },
        },
      },
    },
  },
  "references": {
    "rcs-common-nuget": {
      "path": "D:\\Dev\\rcs-common-nuget",
      "description": "RCS Common Nuget repo",
    },
    "aquiracloud-common-nuget": {
      "path": "D:\\Dev\\aquiracloud-common-nuget",
      "description": "Aquiracloud Common Nuget repo",
    },
    "aquiracloud-common-mongo-nuget": {
      "path": "D:\\Dev\\aquiracloud-common-mongo-nuget",
      "description": "Aquiracloud Common Mongo Nuget repo",
    },
    "rcs-common-mongo-nuget": {
      "path": "D:\\Dev\\rcs-common-mongo-nuget",
      "description": "RCS Common Mongo Nuget repo",
    },
  },
}
